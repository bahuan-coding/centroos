# =============================================================================
# CentrOS - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores necessários
# Valores com "required" são obrigatórios para o sistema funcionar
# Valores com "optional" podem ser deixados em branco para desenvolvimento
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (required)
# -----------------------------------------------------------------------------
# URL de conexão PostgreSQL (Neon ou local)
# Formato: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/centroos

# Usado em deploy Netlify (sobrescreve DATABASE_URL se definido)
# NETLIFY_DATABASE_URL=

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
# Porta do servidor Express (default: 3000)
PORT=3000

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CERTIFICADOS DIGITAIS (optional para dev)
# -----------------------------------------------------------------------------
# Chave de criptografia para armazenar certificados no banco
# IMPORTANTE: Em produção, use uma chave forte de 32 caracteres
CERTIFICATE_ENCRYPTION_KEY=default-dev-key-change-in-prod-32ch

# -----------------------------------------------------------------------------
# NFS-e SÃO PAULO (optional)
# -----------------------------------------------------------------------------
# Credenciais da Prefeitura de SP
NFSE_SP_CNPJ=
NFSE_SP_CCM=
NFSE_SP_SENHA_WEB=

# Ambiente: homologacao | producao
NFSE_AMBIENTE=homologacao

# Usar endpoint legado (deprecated)
NFSE_SP_USE_LEGACY_ENDPOINT=false

# Debug de requisições NFS-e
NFSE_DEBUG=false
XMLDSIG_DEBUG=false

# -----------------------------------------------------------------------------
# NFS-e NACIONAL (optional)
# -----------------------------------------------------------------------------
# Ambiente: producaoRestrita | producao
NFSE_NACIONAL_AMBIENTE=producaoRestrita

# Ambiente para configuração: production | homologation
NFSE_ENVIRONMENT=homologation

# -----------------------------------------------------------------------------
# SERPRO / INTEGRA CONTADOR (optional)
# -----------------------------------------------------------------------------
# Habilitar módulo Integra Contador
INTEGRA_CONTADOR_ENABLED=false

# Credenciais OAuth do SERPRO (Datavalid, Consulta CPF/CNPJ)
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=

# Ambiente SERPRO: production | sandbox
SERPRO_ENVIRONMENT=sandbox

# Usar mTLS para chamadas ao SERPRO (recomendado em produção)
SERPRO_USE_MTLS=false

# Usar ambiente demo do SITFIS
SERPRO_SITFIS_DEMO=true

# -----------------------------------------------------------------------------
# DADOS DA ORGANIZAÇÃO (optional)
# -----------------------------------------------------------------------------
# CNPJ da organização principal (usado em integrações)
PAYCUBED_CNPJ=

# -----------------------------------------------------------------------------
# CLIENT / VITE (optional)
# -----------------------------------------------------------------------------
# Usar dados mockados no frontend (para desenvolvimento sem backend)
VITE_USE_MOCKS=false
